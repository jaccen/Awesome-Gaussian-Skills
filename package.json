{
  "name": "awesome-gaussian-skills",
  "version": "0.9.10",
  "private": true,
  "description": "3D Spatial Intelligence Open-Source Toolbox — 955 methods, 18 skills, MCP Server, SplatVerse Studio",
  "license": "Apache-2.0",
  "homepage": "https://jaccen.github.io/Awesome-Gaussian-Skills/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaccen/Awesome-Gaussian-Skills.git"
  },
  "bugs": {
    "url": "https://github.com/jaccen/Awesome-Gaussian-Skills/issues"
  },
  "keywords": [
    "3d-gaussian-splatting",
    "3dgs",
    "nerf",
    "neural-rendering",
    "computer-graphics",
    "ai-skills",
    "mcp-server",
    "claude-code",
    "openclaw",
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "research-tools",
    "arxiv"
  ],
  "workspaces": [
    "mcp-server",
    "studio/bridge",
    "studio/web"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "dev": "powershell -File scripts/start-dev.ps1",
    "dev:bridge": "npm run dev --workspace=studio/bridge",
    "dev:web": "npm run dev --workspace=studio/web",
    "dev:mcp": "npm run dev --workspace=mcp-server",
    "dev:renderer": "npm run renderer --workspace=mcp-server",
    "build": "npm run build --workspaces",
    "build:bridge": "npm run build --workspace=studio/bridge",
    "build:web": "npm run build --workspace=studio/web",
    "build:mcp": "npm run build --workspace=mcp-server",
    "start": "npm run build && npm run dev",
    "start:all": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-all.ps1",
    "prod": "powershell -File scripts/start-prod.ps1",
    "prod:quick": "powershell -File scripts/start-prod.ps1 -SkipBuild",
    "prod:full": "powershell -File scripts/start-prod.ps1 -Toonflow"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
