# SplatVerse Studio — Environment Configuration
# Copy this file to .env and adjust values as needed.

# --- MCP Server (3DGS Renderer) ---
RENDERER_PORT=9842
# 逗号分隔的 WebSocket Origin 白名单（默认仅放行 localhost 源）
#RENDERER_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 额外的场景导入目录白名单（逗号分隔）
#SCENE_DIRS=D:/my-scenes
# 设为 1 时列出实验性 stub工具
#INCLUDE_EXPERIMENTAL=0

# --- Bridge Server (REST + SSE) ---
BRIDGE_PORT=10590
MCP_SERVER_PATH=mcp-server/dist/index.js
TOONFLOW_URL=http://localhost:10588
STATIC_DIR=.temp/renders
# 设置后 /api/* 需要 Authorization: Bearer <token>（非 localhost 部署必须设置）
#STUDIO_TOKEN=change-me
# CORS 白名单（逗号分隔，默认仅本地 studio web）
#ALLOWED_ORIGINS=http://localhost:5173

# --- Studio Web (Vite) ---
VITE_PORT=5173

# --- Toonflow ---
TOONFLOW_APP_DIR=../../AI应用/Toonflow-app
# 凭据只从环境变量读取（源码不再内置默认账号）
TOONFLOW_USER=
TOONFLOW_PASS=
