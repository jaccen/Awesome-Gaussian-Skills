# ============================================================================
# SplatVerse Studio — 环境配置
# ============================================================================
# 使用方法：
#   1. 复制本文件为 .env
#   2. 按需填写下方各模块的 Key
#   3. 重启服务生效
#
# 标记说明：
#   [必需]   — 端到端管线跑通必须配置
#   [推荐]   — 显著提升效果，不配可用降级方案
#   [可选]   — 锦上添花，不配不影响核心流程
# ============================================================================


# ============================================================================
# 一、LLM 大语言模型  [必需]
# ----------------------------------------------------------------------------
# 用于：剧本改编、智能分镜、图片/视频提示词生成、质量审核
# 接口：OpenAI 兼容（/v1/chat/completions），支持以下供应商任选其一
# ============================================================================

# --- 方案 A：DeepSeek（推荐，性价比最高） ---
# 注册地址：https://platform.deepseek.com
# 价格：约 ¥1/百万Token（远低于 OpenAI）
# 填入后即可使用，无需修改 BASE_URL
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# --- 方案 B：OpenAI ---
# 注册地址：https://platform.openai.com
# 取消下面三行注释并填入你的 OpenAI Key
#LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
#LLM_BASE_URL=https://api.openai.com/v1
#LLM_MODEL=gpt-4o

# --- 方案 C：阿里通义千问 ---
# 注册地址：https://dashscope.aliyun.com
#LLM_API_KEY=sk-xxxxxxxx
#LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#LLM_MODEL=qwen-plus

# --- 方案 D：Moonshot（Kimi） ---
# 注册地址：https://platform.moonshot.cn
#LLM_API_KEY=sk-xxxxxxxx
#LLM_BASE_URL=https://api.moonshot.cn/v1
#LLM_MODEL=moonshot-v1-8k

# --- 方案 E：智谱 GLM ---
# 注册地址：https://open.bigmodel.cn
#LLM_API_KEY=xxxxxxxx.xxxxxxxx
#LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#LLM_MODEL=glm-4-flash

# --- 方案 F：本地部署（Ollama / vLLM） ---
# 需本地运行 Ollama 并拉取模型（如 ollama pull qwen2.5:14b）
#LLM_API_KEY=ollama
#LLM_BASE_URL=http://localhost:11434/v1
#LLM_MODEL=qwen2.5:14b

# --- 方案 G：OneAPI / NewAPI 中转（自建统一网关） ---
# 如果你用 OneAPI 统一管理多个 Key，填中转地址即可
#LLM_API_KEY=sk-your-oneapi-key
#LLM_BASE_URL=http://localhost:3000/v1
#LLM_MODEL=deepseek-chat


# ============================================================================
# 二、TTS 语音合成  [推荐]
# ----------------------------------------------------------------------------
# 用于：角色配音、旁白生成
# 架构：主通道 + 降级通道，主通道失败自动降级
# ============================================================================

# 供应商选择：edge | cosyvoice | openai | aliyun
# edge      = 免费 EdgeTTS（微软），无需 Key，效果可用
# cosyvoice = CosyVoice2（阿里开源TTS，支持声音克隆+情感），需本地部署或API
# openai    = OpenAI TTS API，需 Key
# aliyun    = 阿里云语音合成，需 Key
TTS_PROVIDER=edge

# --- CosyVoice2 配置（TTS_PROVIDER=cosyvoice 时生效）---
# 本地部署：git clone https://github.com/FunAudioLLM/CosyVoice && python api_server.py
# 或使用在线API
#COSYVOICE_URL=http://localhost:5000
#COSYVOICE_API_KEY=

# --- OpenAI TTS 配置（TTS_PROVIDER=openai 时生效）---
# 复用上方的 LLM_API_KEY 即可（同一个 OpenAI Key）
# 模型选择：tts-1（快速）/ tts-1-hd（高清）
#TTS_OPENAI_MODEL=tts-1
#TTS_OPENAI_VOICE=alloy

# --- 阿里云语音合成（TTS_PROVIDER=aliyun 时生效）---
# 获取：https://console.aliyun.com/product/nls
#TTS_ALIYUN_KEY=
#TTS_ALIYUN_APPKEY=
#TTS_ALIYUN_VOICE=siyue


# ============================================================================
# 三、ASR 语音识别  [可选]
# ----------------------------------------------------------------------------
# 用于：从生成的音频反推文字时间轴，精确对齐字幕
# 架构：主通道 + 降级通道
# 不配置时：字幕用 LLM 生成的时间戳估算（精度略低但可用）
# ============================================================================

# 供应商选择：whisper-local | aliyun | tencent | skip
# whisper-local = 本地 Whisper（免费，需安装 whisper 或 faster-whisper）
# aliyun        = 阿里云语音识别API（按量付费）
# tencent       = 腾讯云语音识别API（按量付费）
# skip          = 跳过ASR，用LLM估算时间轴
ASR_PROVIDER=skip

# --- 方案 A：本地 Whisper（推荐，免费） ---
# 安装：pip install openai-whisper（或 pip install faster-whisper）
# 模型选择：tiny / base / small / medium / large
# tiny 最快精度低，large 精度最高需GPU
#ASR_PROVIDER=whisper-local
#ASR_WHISPER_MODEL=base
#ASR_WHISPER_DEVICE=cpu          # cpu | cuda
#ASR_WHISPER_LANGUAGE=zh          # 中文

# --- 方案 B：阿里云语音识别 ---
# 获取：https://console.aliyun.com/product/nls
#ASR_ALIYUN_KEY=
#ASR_ALIYUN_APPKEY=

# --- 方案 C：腾讯云语音识别 ---
# 获取：https://console.cloud.tencent.com/asr
#ASR_TENCENT_SECRET_ID=
#ASR_TENCENT_SECRET_KEY=
#ASR_TENCENT_APP_ID=


# ============================================================================
# 四、视频生成  [推荐]
# ----------------------------------------------------------------------------
# 用于：分镜图片→视频片段驱动（图生视频）
# 架构：主通道 + 降级通道（Ken Burns效果/纯色背景）
# 不配置时：使用 FFmpeg Ken Burns 效果（图片缓慢缩放平移），效果可用但无动作
# ============================================================================

# 供应商选择：seedance | kling | wan-local | skip
# seedance  = 字节 Seedance API（文生视频SOTA，人物一致性好）
# kling     = 快手 Kling API（长视频+动作控制）
# wan-local = 本地 Wan2.1 模型（需GPU，开源免费）
# skip      = 跳过视频生成，使用 Ken Burns 效果
VIDEO_GEN_PROVIDER=skip

# --- 方案 A：Seedance API ---
# 获取：https://www.seedance.ai（字节跳动火山引擎）
#VIDEO_GEN_PROVIDER=seedance
#SEEDANCE_API_KEY=
#SEEDANCE_BASE_URL=https://api.seedance.ai/v1

# --- 方案 B：Kling API ---
# 获取：https://platform.kuaishou.com
#VIDEO_GEN_PROVIDER=kling
#KLING_API_KEY=
#KLING_API_SECRET=
#KLING_BASE_URL=https://api.kuaishou.com/v1

# --- 方案 C：本地 Wan2.1 ---
# 需安装 ComfyUI + WanVideoWrapper（git clone + 模型下载）
# 仅支持 NVIDIA GPU（建议 12GB+ VRAM）
#VIDEO_GEN_PROVIDER=wan-local
#WAN_LOCAL_URL=http://localhost:8188    # ComfyUI API 地址


# ============================================================================
# 五、图片生成  [可选]
# ----------------------------------------------------------------------------
# 用于：分镜画面图片生成（角色+场景）
# 不配置时：依赖 Toonflow 内置图片生成 或使用纯色背景
# ============================================================================

# 供应商选择：toonflow | flux-local | stability | skip
# toonflow      = 使用 Toonflow 已配置的图片模型（推荐，已集成）
# flux-local    = 本地 Flux 模型（需GPU）
# stability     = Stability AI API（图生图）
# skip          = 跳过图片生成
IMAGE_GEN_PROVIDER=toonflow

# --- 方案 B：Stability AI ---
# 获取：https://platform.stability.ai
#IMAGE_GEN_PROVIDER=stability
#STABILITY_API_KEY=

# --- 方案 C：本地 Flux ---
# 需安装 ComfyUI + Flux 模型
#IMAGE_GEN_PROVIDER=flux-local
#FLUX_LOCAL_URL=http://localhost:8188


# ============================================================================
# 六、基础设施  [必需]
# ============================================================================

# --- MCP Server (3DGS 渲染器) ---
RENDERER_PORT=9842
#RENDERER_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
#SCENE_DIRS=D:/my-scenes
#INCLUDE_EXPERIMENTAL=0

# --- Bridge Server (REST + SSE) ---
BRIDGE_PORT=10590
MCP_SERVER_PATH=mcp-server/dist/index.js
STATIC_DIR=.temp/renders
#STUDIO_TOKEN=change-me
#ALLOWED_ORIGINS=http://localhost:5173

# --- Studio Web (Vite) ---
VITE_PORT=5173

# --- Toonflow 短剧引擎 ---
TOONFLOW_APP_DIR=../../AI应用/Toonflow-app
TOONFLOW_URL=http://localhost:10588
TOONFLOW_USER=
TOONFLOW_PASS=

# --- FFmpeg ---
# 默认从系统 PATH 查找，如需指定路径取消注释
#FFMPEG_PATH=ffmpeg
#FFPROBE_PATH=ffprobe

# --- Pipeline 输出目录 ---
PIPELINE_OUTPUT_DIR=.temp/pipeline


# ============================================================================
# 七、MoneyPrinterTurbo (MPT) 集成  [可选]
# ----------------------------------------------------------------------------
# MPT 是一个成熟的 AI 短视频生成工具，作为 Studio 的能力扩展层：
#   - 最终降级：当 3DGS / Toonflow / 视频驱动全失败时，用 MPT 在线素材生成完整视频
#   - TTS 扩展：扩展音色选择面（Azure / SiliconFlow / ElevenLabs / Chatterbox / Gemini）
#   - 跨平台发布：TikTok / Instagram / YouTube Shorts
#   - BGM 曲库：本地曲库 + ElevenLabs Music + Sonilo AI 生成
#
# 部署方式：
#   1. docker compose -f docker-compose.mpt.yml up -d
#   2. 修改 MPT 侧 config.toml 填入 Pexels / Pixabay API Key（素材检索用）
#   3. 设置下方 MPT_ENABLED=true
# ============================================================================

# 是否启用 MPT 集成（默认 false，不影响现有管线行为）
MPT_ENABLED=false

# MPT FastAPI 服务地址（docker-compose.mpt.yml 中映射的 API 端口 8081；
# 8501 是 MPT WebUI/Streamlit 端口，勿混用）
MPT_API_URL=http://localhost:8081

# 素材来源：pexels / pixabay / coverr / local
MPT_MATERIAL_SOURCE=pexels

# MPT 默认 TTS 音色
MPT_DEFAULT_VOICE=zh-CN-XiaoxiaoNeural

# --- MPT 侧配置（在 mpt-config.toml 中设置，非此处 .env）---
# MPT 需要以下素材 API Key（在 MPT 的 config.toml 中配置）：
#   PEXELS_API_KEY     — https://www.pexels.com/api/  （免费）
#   PIXABAY_API_KEY    — https://pixabay.com/api/docs/（免费）
#   COVERR_API_KEY     — https://coverr.co/            （免费）


# ============================================================================
# 配置检查清单
# ============================================================================
# 最低可用配置（只需 1 个 Key 即可跑通管线）：
#   [1] LLM_API_KEY       — DeepSeek Key（注册即送免费额度）
#   [2] TTS_PROVIDER=edge — 免费 EdgeTTS，无需 Key
#   [3] ASR_PROVIDER=skip — 跳过ASR
#   [4] VIDEO_GEN_PROVIDER=skip — 使用 Ken Burns 效果
#
# 推荐配置（效果最佳）：
#   [1] LLM_API_KEY       — DeepSeek Key
#   [2] TTS_PROVIDER=cosyvoice + COSYVOICE_URL — 高质量配音+声音克隆
#   [3] ASR_PROVIDER=whisper-local — 精确字幕对齐（pip install openai-whisper）
#   [4] VIDEO_GEN_PROVIDER=seedance + SEEDANCE_API_KEY — 图生视频SOTA
#
# 完整配置（全功能）：
#   在推荐配置基础上 + IMAGE_GEN_PROVIDER=toonflow + Toonflow 凭据
# ============================================================================
