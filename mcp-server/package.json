{
  "name": "3dgs-mcp-renderer-server",
  "version": "0.8.0",
  "description": "MCP server for Agent-controlled 3D Gaussian Splatting rendering pipeline",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "3dgs-mcp-server": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "renderer": "npx http-server renderer -p 8080 -c-1",
    "demo": "tsx examples/voice-demo.ts",
    "test": "node --test test/",
    "test:build": "tsc && node --test test/"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.10",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "mcp",
    "3dgs",
    "gaussian-splatting",
    "three.js",
    "webgpu",
    "agent",
    "rendering"
  ]
}
