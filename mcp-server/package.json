{
  "name": "3dgs-mcp-server",
  "version": "1.1.0",
  "description": "MCP server for Agent-controlled 3D Gaussian Splatting rendering pipeline — 21 tools over stdio (import scene, set camera, modify gaussians, render frame, sculpt pipeline, SLAT latent editing).",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "3dgs-mcp-server": "dist/index.js"
  },
  "files": [
    "dist",
    "renderer",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaccen/Awesome-Gaussian-Skills.git",
    "directory": "mcp-server"
  },
  "homepage": "https://github.com/jaccen/Awesome-Gaussian-Skills/tree/main/mcp-server#readme",
  "bugs": {
    "url": "https://github.com/jaccen/Awesome-Gaussian-Skills/issues"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "renderer": "npx http-server renderer -p 8080 -c-1",
    "demo": "tsx examples/voice-demo.ts",
    "test": "node --test test/",
    "test:build": "tsc && node --test test/",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.10",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "3dgs",
    "gaussian-splatting",
    "three.js",
    "webgpu",
    "agent",
    "rendering",
    "nerf",
    "neural-rendering"
  ]
}
