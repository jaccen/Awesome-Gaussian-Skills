{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Evidence-led research review",
  "description": "Structure and declared provenance only; validation does not establish truth.",
  "type": "object",
  "required": ["question", "evidence_date", "findings", "limitations"],
  "properties": {
    "question": {"type": "string", "minLength": 1},
    "evidence_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["observation", "status", "evidence", "recommendation"],
        "properties": {
          "observation": {"type": "string", "minLength": 1},
          "status": {"type": "string", "enum": ["supported", "unresolved", "not-applicable"]},
          "evidence": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "required": ["source", "location", "scope"],
              "properties": {
                "source": {"type": "string", "minLength": 1},
                "location": {"type": "string", "minLength": 1},
                "scope": {"type": "string", "minLength": 1}
              }
            }
          },
          "recommendation": {"type": "string", "minLength": 1}
        }
      }
    },
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
